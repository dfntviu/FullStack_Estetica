# Copia este archivo como .env y ajusta los valores. .env NO se sube a git.
PGHOST=localhost
# Puerto de tu PostgreSQL 18 (por ejemplo 5433 si convive con otra versión instalada)
PGPORT=5432
PGUSER=postgres
PGPASSWORD=peluqueria.test
PGDATABASE=estetica
PG_POOL_MAX=10

PORT=3000
# Orígenes del front permitidos (separados por coma). El puerto cuenta: 4200 = ng serve (Angular)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
ZONA_NEGOCIO=America/Mexico_City
