    {
      "name": "6. Reportes y caja",
      "description": "Auditoría, ingresos y cierres (database/schemas/auditoria-reportes.sql). El periodo es el trimestre que termina hoy: lo calcula el pre-request de la carpeta. El cierre de caja solo se prueba con un día FUTURO (400): cerrar hoy bloquearía los cobros del día.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const f = (d) => d.toLocaleDateString('en-CA', { timeZone: 'America/Mexico_City' });",
              "const hoy = new Date();",
              "pm.collectionVariables.set('hoy', f(hoy));",
              "pm.collectionVariables.set('hace89', f(new Date(hoy.getTime() - 89 * 864e5)));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Ingresos del trimestre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reportes/ingresos?desde={{hace89}}&hasta={{hoy}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "ingresos"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "{{hace89}}"
                },
                {
                  "key": "hasta",
                  "value": "{{hoy}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('90 días en la serie (generate_series)', () => pm.expect(r.porDia).to.have.length(90));",
                  "pm.test('fila total del ROLLUP al 100 %', () => pm.expect(r.porMetodo.find(m => m.metodo === 'total').participacionPct).to.eql(100));",
                  "pm.test('acumulado = ingresos del periodo', () => pm.expect(r.porDia.at(-1).acumulado).to.eql(r.resumen.ingresos));"
                ]
              }
            }
          ]
        },
